<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <property name="default_admin_user_email" value="mateusz.marek.mucha@gmail.com" dbms="postgresql"/>

    <changeSet id="003" author="mateusz.mucha">

        <createTable tableName="order_price">

            <column name="id" type="uuid">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="value" type="numeric(20,2)">
                <constraints nullable="false"/>
            </column>

            <column name="currency" type="varchar(5)">
                <constraints nullable="false"/>
            </column>

            <column name="date" type="varchar(10)">
                <constraints nullable="false"/>
            </column>

            <column name="is_price_original" type="boolean" defaultValue="true">
                <constraints nullable="false"/>
            </column>

            <column name="is_price_converted" type="boolean" defaultValue="false">
                <constraints nullable="false"/>
            </column>

            <column name="order_id" type="uuid">
                <constraints nullable="false"/>
            </column>

            <column name="is_deleted" type="boolean" defaultValue="false">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE" defaultValue="now()">
                <constraints nullable="false"/>
            </column>

            <column name="last_modified_at" type="TIMESTAMP WITHOUT TIME ZONE" defaultValue="now()">
                <constraints nullable="false"/>
            </column>

            <column name="version" type="integer" defaultValue="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey columnNames="id" tableName="order_price"/>
        <addUniqueConstraint columnNames="id" tableName="order_price"/>

        <createIndex indexName="idx_order_price_currency" tableName="order_price">
            <column name="currency"/>
        </createIndex>

        <createIndex indexName="idx_order_price_is_price_original" tableName="order_price">
            <column name="is_price_original"/>
        </createIndex>

        <createIndex indexName="idx_order_price_is_price_converted" tableName="order_price">
            <column name="is_price_converted"/>
        </createIndex>

        <createIndex indexName="idx_order_price_is_deleted" tableName="order_price">
            <column name="is_deleted"/>
        </createIndex>

        <createIndex indexName="idx_order_price_order_id_is_price_original" tableName="order_price">
            <column name="order_id"/>
            <column name="is_price_original"/>
        </createIndex>

        <createIndex indexName="idx_order_price_is_price_original_is_price_converted" tableName="order_price">
            <column name="is_price_original"/>
            <column name="is_price_converted"/>
        </createIndex>

        <createIndex indexName="idx_order_price_is_price_original_currency" tableName="order_price">
            <column name="is_price_original"/>
            <column name="currency"/>
        </createIndex>

        <createIndex indexName="idx_order_price_order_id_currency" tableName="order_price">
            <column name="order_id"/>
            <column name="currency"/>
        </createIndex>

        <addUniqueConstraint
                columnNames="order_id, currency, date"
                constraintName="uq_order_price"
                tableName="order_price"
        />

        <addForeignKeyConstraint baseTableName="order_price"
                                 baseColumnNames="order_id"
                                 constraintName="fk_order_price_id"
                                 referencedTableName="order"
                                 referencedColumnNames="id"
                                 onUpdate="CASCADE"
                                 onDelete="CASCADE"
        />

    </changeSet>

</databaseChangeLog>